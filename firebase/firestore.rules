rules_version = '2';

// Clink's Firestore rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// The content import tool uses the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Card packs and their version: any signed-in user (anonymous guests too) may read; nobody writes from the app.
    match /packs/{packId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A profile belongs to its user only: name 1–20 characters and a preset avatar id, nothing else.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'avatarId'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.size() <= 32;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
